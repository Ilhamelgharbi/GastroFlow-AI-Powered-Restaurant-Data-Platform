project_id = "your-project-id"
region     = "europe-west1"
prefix     = "gastroflow"

# Keep destructive cleanup disabled for shared or persistent data.
gastroflow_enable_ai="true"
force_destroy  = false
enable_composer = false
gemini_api_key ="yourapikey"
# Set to an image version available in the chosen region before enabling Composer.
# composer_image_version = "composer-3-airflow-..."