GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west1
GCS_BUCKET=your-project-id-gastroflow-lake
GCS_PREFIX=raw/
BQ_RAW_DATASET=gastroflow_raw
# Reserved for future review enrichment; not used by the local Airflow DAG.
BQ_AI_DATASET=gastroflow_ai
DBT_DATASET=gastroflow_staging

# Local Airflow only. Leave GCP_ADC_FILE blank to use the standard Windows ADC path.
GCP_ADC_FILE=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-local-password
AIRFLOW_API_JWT_SECRET=replace-with-a-random-local-secret
